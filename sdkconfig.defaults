CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Keep a two-way USB Serial/JTAG console available for safe-mode service.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Runtime watchdog policy for ESP32-S3 with PSRAM. Keep the canary and both
# watchdogs enabled; the 800 ms IWDT value is the IDF PSRAM baseline.
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# Keep the task watchdog diagnostic-only; application supervision handles
# monitored task recovery. Validate the timeout against slow paths on hardware.
# CONFIG_ESP_TASK_WDT_PANIC is not set
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=0
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Send general-purpose allocations (including LVGL widgets) to PSRAM first.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Keep internal RAM available for Wi-Fi, DMA and other internal-only uses.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# LVGL widgets are dynamic; use ESP-IDF malloc so they do not share a fixed 64 KiB pool.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_QRCODE=y
# Catalog responses are capped at 64 KiB; reject excessively nested JSON safely.
CONFIG_CJSON_NESTING_LIMIT=64
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# Configure Wi-Fi and TCP buffers for the target board's available memory.
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_WIFI_RMT_RX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_WIFI_RMT_STATIC_TX_BUFFER=y
CONFIG_WIFI_RMT_STATIC_TX_BUFFER_NUM=16
CONFIG_WIFI_RMT_CACHE_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
